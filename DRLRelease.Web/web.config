<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- 1. Allow large file uploads (200 MB) and unlisted extensions -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="209715200" />
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".msixbundle" allowed="true" />
            <add fileExtension=".msix" allowed="true" />
            <add fileExtension=".appinstaller" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>

      <!-- 2. Ensure IIS knows how to serve these file types -->
      <staticContent>
        <remove fileExtension=".msixbundle" />
        <mimeMap fileExtension=".msixbundle" mimeType="application/vnd.ms-appx.bundle" />
        <remove fileExtension=".msix" />
        <mimeMap fileExtension=".msix" mimeType="application/vnd.ms-appx" />
        <remove fileExtension=".appinstaller" />
        <mimeMap fileExtension=".appinstaller" mimeType="application/appinstaller" />
      </staticContent>

      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath=".\DRLRelease.Web.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

    </system.webServer>
  </location>
</configuration>