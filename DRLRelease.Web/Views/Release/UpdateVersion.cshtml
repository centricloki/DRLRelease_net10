@{
    ViewData["Title"] = "UpdateVersion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/css/ReleaseModule/UpdateVersion.css" rel="stylesheet" />
}

<div class="container">
    <div class="hero-unit">
        <div class="brand">
            <h1>Update Production Version</h1>
        </div>
    </div>
    <div class="header-image header-image-subpage">
        @if (Model.TestVersionList.Count > 0)
        {
            <span class="page-note">Select Application Version to move into Production</span>

            <div class="page-contain">
                <!-- Radio buttons with proper alignment -->
                <div class="update-version-radios">
                    @foreach (var item in Model.TestVersionList)
                    {
                        var id = "version" + item.AppVersionID.ToString();
                        <div class="radio-inline-item">
                            <input id="@id" type="radio" name="newversion" />
                            <label for="@id">V_@item.Version.ToString()</label>
                        </div>
                    }
                </div>

                <div class="formpage" id="trwhatsnew">
                    <div class="page-left">
                        <label></label>
                    </div>
                    <div class="page-right">
                        <div class="production-verion-inner">
                            <span>WHAT'S NEW IN VERSION</span>
                            <label id="lblVesion">0</label>
                        </div>
                        <ul id="ullist" class="ullist"></ul>
                    </div>
                </div>

                <div class="formpage">
                    <div class="page-left"></div>
                    <div class="page-right">
                        <input id="btnCancel" class="btn" type="button" value="Cancel" data-url="@Url.Action("Index", "Release")" />
                        <input id="btnUpdate" class="button" type="button" value="Update" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <span class="page-note textValidation">There is no anymore application available to move into Production</span>
            <div class="page-contain">
                <div class="formpage">
                    <div class="page-left">
                        <label></label>
                    </div>
                    <div class="page-right">
                        <span>No version available</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="~/js/ReleaseModule/UpdateVersion.js"></script>
}
