@model DRLRelease.Web.Models.AssignVersionModel

<div class="web_dialog_header assign-dialog-header">
    <span class="assign-dialog-title">Assign Version</span>
    <a href="javascript:void(0);" class="dialog-close">&times;</a>
</div>
<div class="web_dialog_content assign-dialog-content">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="assign-dialog-error">@Model.ErrorMessage</div>
    }
    <div class="assign-dialog-field">
        <label class="assign-dialog-label">Selected Users:</label>
        <p class="assign-dialog-value">@Model.UserNames</p>
        <input type="hidden" id="hiddenUserIds" value="@Model.UserIDs" />
    </div>
    <div class="assign-dialog-field">
        <label class="assign-dialog-label">Current Version:</label>
        <p class="assign-dialog-value">@Model.CurrentVersion</p>
        <input type="hidden" id="CurrentVersionId" value="@Model.CurrentVersionId" />
    </div>
    <div class="assign-dialog-field-lg">
        <label class="assign-dialog-label">Assign New Version:</label>
        @if (Model.AssignList != null && Model.AssignList.Any())
        {
            <select id="ddlAssignVersion" class="form-control assign-dialog-select" @(Model.IsDisabledButton ? "disabled" : "")>
                <option value="">-- Select Version --</option>
                @foreach (var item in Model.AssignList)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        }
        else
        {
            <p class="assign-dialog-empty">No versions available for assignment.</p>
        }
    </div>
    <div class="assign-dialog-footer">
        <button type="button" id="btnassingdialogcancel" class="btn btn-secondary assign-btn-cancel">Cancel</button>
        <button type="button" id="btnAssign" class="btn btn-primary assign-btn-primary" @(Model.IsDisabledButton ? "disabled" : "")>Assign</button>
    </div>
</div>
