@model DRLRelease.Web.Models.AssignVersionModel

<div class="web_dialog_header">
    <h3>Assign Version</h3>
    <a href="javascript:void(0);" onclick="HideDialog('AssignVersion_dialog');" style="float: right; color: white; font-weight: bold; text-decoration: none;">X</a>
</div>
<div class="web_dialog_content" style="padding: 20px;">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <div class="form-group" style="margin-bottom: 15px;">
        <label class="control-label fw-bold">Selected Users:</label>
        <p id="txtAV_UserID" style="margin: 5px 0;">@Model.UserNames</p>
        <input type="hidden" id="hiddenUserIds" value="@Model.UserIDs" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label class="form-label fw-bold">Current Version:</label>
        <p style="margin: 5px 0;">@Model.CurrentVersion</p>
        <input type="hidden" id="CurrentVersionId" value="@Model.CurrentVersionId" />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label class="form-label fw-bold">Assign New Version:</label>
        @if (Model.AssignList != null && Model.AssignList.Any())
        {
            <select id="ddlAssignVersion" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" @(Model.IsDisabledButton ? "disabled" : "")>
                <option value="">-- Select Version --</option>
                @foreach (var item in Model.AssignList)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        }
        else
        {
            <p class="text-danger">No versions available for assignment.</p>
        }
    </div>

    <div style="text-align: right; margin-top: 20px;">
        <button type="button" id="btnassingdialogcancel" class="btn btn-secondary" style="margin-right: 10px;" onclick="HideDialog('AssignVersion_dialog');">Cancel</button>
        <button type="button" id="btnAssign" class="btn btn-primary" @(Model.IsDisabledButton ? "disabled" : "") onclick="SubmitAssignVersion();">Assign</button>
    </div>
</div>