@model DRLRelease.Web.Models.UploadNewAppModel
@{
    ViewData["Title"] = "UploadNewApp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/css/ReleaseModule/UploadNewApp.css" rel="stylesheet" />
}

@using (Html.BeginForm("UploadNewApp", "Release", FormMethod.Post, new { enctype = "multipart/form-data", @id = "formuploadnewapp" }))
{
    @Html.AntiForgeryToken()

    <div class="container">
        <div class="hero-unit">
            <div class="brand">
                <h1>Upload New Application Version</h1>
            </div>
        </div>
        <div class="header-image header-image-upload">
            <span class="page-note"> @Html.DisplayFor(m => m.FileSizeNote)</span>
            @Html.ValidationSummary(true)
            <span class="message-success">@ViewBag.result</span>
            <div class="page-contain">

                <!-- IPA row -->
                <div class="formpage">
                    <div class="page-left">
                        <label>MSIXBUNDLE :</label>
                    </div>
                    <div class="page-right">
                        @Html.TextBoxFor(m => m.fileUpIPA, new { type = "file", id = "fileUpIPA" })
                        @Html.ValidationMessageFor(m => m.fileUpIPA)
                    </div>
                </div>

                <!-- PLIST row -->
                <div class="formpage">
                    <div class="page-left">
                        <label>XML :</label>
                    </div>
                    <div class="page-right">
                        @Html.TextBoxFor(m => m.fileUpPLIST, new { type = "file", id = "fileUpPLIST" })
                        @Html.ValidationMessageFor(m => m.fileUpPLIST)
                    </div>
                </div>

                <!-- Buttons row -->
                <div class="formpage">
                    <div class="page-left">
                    </div>
                    <div class="page-right">
                        <input id="btnUploadClear" class="btn" type="button" value="Clear" />
                        <input id="btnSubmit" class="button" type="submit" value="Upload" />
                    </div>
                </div>
            </div>
            <div class="uploadnewv-footer">
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="~/js/ReleaseModule/UploadNewApp.js"></script>
}
