@model DRLRelease.Web.Models.UploadProductionVersionModel
<script src="~/js/ReleaseModule/UpdateProductionVersion.js"></script>

<div class="web_dialog_header">
    <div class="web_dialog_title">Update Production Version</div>
    <div class="web_dialog_close align_right">
        <a href="javascript:void(0);" id="btndialogClose">X</a>
    </div>
</div>
<div class="web_dialog_body">
    <div class="formpage">
        <div class="innerheader">
            @if (Model.TestVersionList.Count > 0)
            {
                <span>Select Application Version to move into Production</span>
            }
            else
            {
                <span class="textValidation">There is no anymore application available to move into Production</span>
            }
        </div>
    </div>
    <div class="formpage">
        <div class="innerheader">
            <ul class="radiobuttonlist">
                @foreach (var item in Model.TestVersionList)
                {
                    var id = "version" + item.AppVersionID.ToString();
                    <li>
                        <input id="@id" type="radio" name="newversion" />
                        <label for="@id">V_@item.Version.ToString()</label>
                    </li>
                }
            </ul>
        </div>
    </div>
    <hr style="color: #8E8E8E;height: 0.5px;float: left;width: 100%;margin: 0;">
    <div id="trwhatsnew" style="display:none">
        <div class="production-verion-inner">
            <span>WHAT'S NEW IN VERSION</span>
            <label id="lblVesion">0</label>
        </div>
        <div style="height:auto; overflow: auto; float:left; ">
            <ul id="ullist" class="ullist"></ul>
        </div>
        <div class="formpage">
            <div class="page-left" style="width:84%;">
                <input id="txtWhatsNew" class="pversion-text" type="text" />
            </div>
            <div class="page-right" style="width:15% !important">
                <a id="btnAddNew" class="button popup-margin-left" style="float: right;margin-right: 6px;margin-top:2px;" href="javascript:void(0);">Add</a>
            </div>
        </div>
    </div>
</div>
<div class="web_dialog_footer">
    <a id="btnUPVdialogcancel" class="button popup-margin-left" style="float: right;margin-right: 12px;" href="javascript:void(0);">Cancel</a>
    <a id="btnUpdate" class="button popup-margin-left" style="float: right;margin-right: 6px;" href="javascript:void(0);">Update</a>
</div>