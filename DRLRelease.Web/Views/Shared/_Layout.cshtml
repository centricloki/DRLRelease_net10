<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Release Management</title>
    <link href="~/release.ico" rel="shortcut icon" type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    <partial name="_CommonHead" />
    <link href="~/Content/bootstrap-responsive.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <!-- add this line right after the master stylesheet -->
    <link href="~/Content/dialog-versions-vertical.css" rel="stylesheet" />
    <link href="~/css/common.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <!-- HTML5 shim, for IE6-8 support of HTML5 elements -->
    <!--[if lt IE 9]>
        <script src="~/Scripts/html5shiv.js"></script>
    <![endif]-->
</head>
<body>
    <div id="overlay" class="web_dialog_overlay"></div>
    <div id="UploadProductionVersion_dialog" class="web_dialog"></div>
    <!-- Main menu starts here -->
    <div class="navbar">
        <div class="navbar-inner">
            <div class="container">
                <a class="btn btn-navbar" data-toggle="collapse" data-target=".nav-collapse">
                    <span>
                        @*<img src="img/menu-icon.png" width="22" height="23">*@
                        <img src="~/Images/logo.png" width="46" />
                    </span>
                </a>
                <div class="nav-collapse collapse">
                    <ul class="nav">
                        <li><a href="@Url.Action("Index", "Release")" class="active">Home</a></li>
                        <li><a href="@Url.Action("UploadNewApp", "Release")">Upload New App</a></li>
                        <li><a href="@Url.Action("UpdateVersion", "Release")">Update Version</a></li>
                        <li><a href="@Url.Action("AppVersions", "Release")">App Version</a></li>
                    </ul>
                </div>
                <div class="search">
                    <section id="login">
                        <partial name="_LoginPartial" />
                    </section>
                </div>
            </div>
        </div>
    </div>
    <!-- Main Menu end -->
    <div class="wrap bg1">
        <div class="container">
            <div id="msgContainer">
                <label id="lblMessage"></label>
            </div>
        </div>
        @RenderBody()
    </div>

    <div class="wrap bg3 spacing-top-bottom footer-spacing">
        <div class="container">
            <div class="row-fluid">
                <div class="span4">
                    <div class="copy-rights">
                        <p>&copy; @DateTime.Now.Year - DRL Release Management System</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
